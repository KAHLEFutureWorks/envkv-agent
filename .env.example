# Diese Werte nur auf dem Entwicklungsrechner oder Server setzen, niemals committen.
VW_CLIENT_ID=
VW_CLIENT_SECRET=

# Der Katalog ist marktbezogen. Für KAHLE ist DE der erwartete Ausgangspunkt.
VW_MARKET=DE

# Backend-Zugriff und lokale Persistenz
EXTENSION_API_KEY=
ENVKV_DATABASE_PATH=./data/envkv.sqlite3

# Angebotsdatum und Erstellungsdatum folgen dieser Zeitzone.
ENVKV_TIMEZONE=Europe/Berlin
CACHE_TTL_SECONDS=86400

# OKAPI begrenzt die Aufrufrate. Diese Werte bremsen den Abruf einer ganzen
# Modellfamilie und wiederholen abgewiesene Anfragen mit wachsender Wartezeit.
OKAPI_MAX_RETRIES=4
OKAPI_MIN_INTERVAL_SECONDS=0.2
AUDIT_RETENTION_DAYS=90

# Zentral gepflegte EnVKV-Basiswerte
# Diese Werte dienen nur der technischen Rechenkonfiguration fuer Werbetexte;
# dort werden keine Kosten ausgegeben. Fuer Angebote gilt ausschliesslich das
# datierte amtliche Preisprofil aus backend/app/services/price_profiles.py.
ELECTRICITY_PRICE_EUR_KWH=0.321
ELECTRICITY_REFERENCE_YEAR=2025
PETROL_PRICE_EUR_L=1.744
DIESEL_PRICE_EUR_L=1.610
FUEL_REFERENCE_YEAR=2025
ANNUAL_DISTANCE_KM=15000
CO2_PRICE_LOW_EUR_T=60
CO2_PRICE_MEDIUM_EUR_T=142.5
CO2_PRICE_HIGH_EUR_T=220
CO2_COST_PERIOD_YEARS=10
